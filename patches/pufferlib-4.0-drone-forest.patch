diff --git a/ocean/drone/task_forest.h b/ocean/drone/task_forest.h
new file mode 100644
index 0000000..d8fd884
--- /dev/null
+++ b/ocean/drone/task_forest.h
@@ -0,0 +1,199 @@
+#pragma once
+
+#include "drone.h"
+
+#define FOREST_MAX_TREES 64
+#define FOREST_NUM_RAYS 8
+#define FOREST_OBS_OFFSET 13
+#define FOREST_EPSILON 1e-6f
+
+typedef struct {
+    Vec3 pos;
+    float radius;
+} ForestTree;
+
+typedef struct {
+    int tree_count;
+    float tree_radius_min;
+    float tree_radius_max;
+    float sensor_range;
+    float drone_radius;
+    float goal_radius;
+    float alpha_dist;
+    float alpha_clearance;
+    float clearance_target;
+    float collision_penalty;
+    float success_reward;
+    int horizon;
+} ForestConfig;
+
+typedef struct {
+    ForestTree trees[FOREST_MAX_TREES];
+    unsigned char* collided;
+    unsigned char* succeeded;
+    float* min_clearance;
+} ForestState;
+
+static inline float forest_dist_xy(Vec3 a, Vec3 b) {
+    float dx = a.x - b.x;
+    float dy = a.y - b.y;
+    return sqrtf(dx * dx + dy * dy);
+}
+
+static inline bool forest_tree_overlaps(const ForestState* state, int count, Vec3 pos,
+                                        float radius, float margin) {
+    for (int i = 0; i < count; i++) {
+        const ForestTree* tree = &state->trees[i];
+        if (forest_dist_xy(tree->pos, pos) < tree->radius + radius + margin) return true;
+    }
+    return false;
+}
+
+static void forest_generate(DroneEnv* env) {
+    ForestConfig* cfg = (ForestConfig*)env->task_config;
+    ForestState* state = (ForestState*)env->task_state;
+    const Vec3 start = {-MARGIN_X, 0.0f, 0.0f};
+    const Vec3 goal = {MARGIN_X, 0.0f, 0.0f};
+
+    int count = 0;
+    int attempts = 0;
+    int max_attempts = cfg->tree_count * 32;
+    while (count < cfg->tree_count && attempts++ < max_attempts) {
+        ForestTree candidate = {
+            .pos = {rndf(-MARGIN_X + 1.5f, MARGIN_X - 1.5f, &env->rng),
+                    rndf(-MARGIN_Y + 1.0f, MARGIN_Y - 1.0f, &env->rng), 0.0f},
+            .radius = rndf(cfg->tree_radius_min, cfg->tree_radius_max, &env->rng),
+        };
+        if (forest_dist_xy(candidate.pos, start) < candidate.radius + 1.5f) continue;
+        if (forest_dist_xy(candidate.pos, goal) < candidate.radius + 1.5f) continue;
+        if (forest_tree_overlaps(state, count, candidate.pos, candidate.radius, 0.35f)) continue;
+        state->trees[count++] = candidate;
+    }
+    cfg->tree_count = count;
+}
+
+static inline float forest_ray_distance(const ForestConfig* cfg, const ForestState* state,
+                                        Vec3 origin, Vec3 direction) {
+    float nearest = cfg->sensor_range;
+    for (int i = 0; i < cfg->tree_count; i++) {
+        const ForestTree* tree = &state->trees[i];
+        float ox = origin.x - tree->pos.x;
+        float oy = origin.y - tree->pos.y;
+        float b = ox * direction.x + oy * direction.y;
+        float c = ox * ox + oy * oy - tree->radius * tree->radius;
+        float disc = b * b - c;
+        if (disc < 0.0f) continue;
+        float root = sqrtf(disc);
+        float t = -b - root;
+        if (t < 0.0f) t = -b + root;
+        if (t >= 0.0f && t < nearest) nearest = t;
+    }
+    return nearest;
+}
+
+static float forest_clearance(const ForestConfig* cfg, const ForestState* state, Vec3 pos) {
+    float nearest = cfg->sensor_range;
+    for (int i = 0; i < cfg->tree_count; i++) {
+        float clearance = forest_dist_xy(pos, state->trees[i].pos) - state->trees[i].radius;
+        nearest = fminf(nearest, clearance);
+    }
+    return nearest;
+}
+
+static bool forest_collides(const ForestConfig* cfg, const ForestState* state, Vec3 pos) {
+    return forest_clearance(cfg, state, pos) <= cfg->drone_radius;
+}
+
+static void forest_write_observations(DroneEnv* env, Drone* agent, float* observations) {
+    ForestConfig* cfg = (ForestConfig*)env->task_config;
+    ForestState* state = (ForestState*)env->task_state;
+    for (int i = 0; i < FOREST_NUM_RAYS; i++) {
+        float angle = 2.0f * (float)M_PI * (float)i / (float)FOREST_NUM_RAYS;
+        Vec3 body_ray = {cosf(angle), sinf(angle), 0.0f};
+        Vec3 world_ray = quat_rotate(agent->state.quat, body_ray);
+        float horizontal_len = sqrtf(world_ray.x * world_ray.x + world_ray.y * world_ray.y);
+        if (horizontal_len > FOREST_EPSILON) {
+            world_ray.x /= horizontal_len;
+            world_ray.y /= horizontal_len;
+        } else {
+            world_ray = body_ray;
+        }
+        float distance = forest_ray_distance(cfg, state, agent->state.pos, world_ray);
+        observations[FOREST_OBS_OFFSET + i] = clampf(distance / cfg->sensor_range, 0.0f, 1.0f);
+    }
+}
+
+static void forest_init(DroneEnv* env) {
+    ForestState* state = (ForestState*)calloc(1, sizeof(ForestState));
+    state->collided = (unsigned char*)calloc(env->num_agents, sizeof(unsigned char));
+    state->succeeded = (unsigned char*)calloc(env->num_agents, sizeof(unsigned char));
+    state->min_clearance = (float*)calloc(env->num_agents, sizeof(float));
+    env->task_state = state;
+}
+
+static void forest_close(DroneEnv* env) {
+    ForestState* state = (ForestState*)env->task_state;
+    if (state != NULL) {
+        free(state->collided);
+        free(state->succeeded);
+        free(state->min_clearance);
+        free(state);
+    }
+    free(env->task_config);
+}
+
+static void forest_reset(DroneEnv* env, Drone* agent, int idx) {
+    ForestConfig* cfg = (ForestConfig*)env->task_config;
+    ForestState* state = (ForestState*)env->task_state;
+    if (idx == 0) forest_generate(env);
+
+    agent->state.pos = (Vec3){-MARGIN_X, rndf(-0.5f, 0.5f, &env->rng),
+                              rndf(-1.0f, 1.0f, &env->rng)};
+    agent->target->pos = (Vec3){MARGIN_X, rndf(-0.5f, 0.5f, &env->rng),
+                                rndf(-1.0f, 1.0f, &env->rng)};
+    agent->target->vel = (Vec3){0.0f, 0.0f, 0.0f};
+    agent->target->normal = (Vec3){0.0f, 0.0f, 0.0f};
+    state->collided[idx] = 0;
+    state->succeeded[idx] = 0;
+    state->min_clearance[idx] = cfg->sensor_range;
+}
+
+static float forest_reward(DroneEnv* env, Drone* agent, int idx, StepCache* cache) {
+    ForestConfig* cfg = (ForestConfig*)env->task_config;
+    ForestState* state = (ForestState*)env->task_state;
+    float clearance = forest_clearance(cfg, state, agent->state.pos);
+    state->min_clearance[idx] = fminf(state->min_clearance[idx], clearance);
+
+    float reward = cfg->alpha_dist * (cache->prev_dist - cache->dist);
+    if (clearance < cfg->clearance_target) {
+        float unsafe = (cfg->clearance_target - clearance) / cfg->clearance_target;
+        reward -= cfg->alpha_clearance * clampf(unsafe, 0.0f, 1.0f);
+    }
+
+    state->collided[idx] = forest_collides(cfg, state, agent->state.pos);
+    state->succeeded[idx] = cache->dist <= cfg->goal_radius;
+    if (state->collided[idx]) reward -= cfg->collision_penalty;
+    if (state->succeeded[idx]) reward += cfg->success_reward;
+    return reward;
+}
+
+static bool forest_done(DroneEnv* env, Drone* agent, int idx, StepCache* cache) {
+    ForestConfig* cfg = (ForestConfig*)env->task_config;
+    ForestState* state = (ForestState*)env->task_state;
+    return state->collided[idx] || state->succeeded[idx] || out_of_bounds(agent->state.pos, 1.0f) ||
+           agent->episode_length >= cfg->horizon;
+}
+
+static void forest_log(DroneEnv* env, Drone* agent, int idx, Log* log, StepCache* cache) {
+    (void)agent;
+    (void)cache;
+    ForestState* state = (ForestState*)env->task_state;
+    TaskLog* task = &log->task[TASK_FOREST];
+    task->n += 1.0f;
+    task->perf += state->succeeded[idx] ? 1.0f : 0.0f;
+    task->score += state->succeeded[idx] ? 1.0f : 0.0f;
+    task->keys[0] += state->succeeded[idx] ? 1.0f : 0.0f;
+    task->keys[1] += state->collided[idx] ? 1.0f : 0.0f;
+    task->keys[2] += state->min_clearance[idx];
+    task->keys[3] += out_of_bounds(agent->state.pos, 1.0f) ? 1.0f : 0.0f;
+}
